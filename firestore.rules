rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isAnonymous() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email in ['admin@rsn-taller.edu', 'alejan@'] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 1. User Profiles
    match /userProfiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.role == 'registered_user';
      allow update: if (isOwner(uid) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Designated Admins Collection
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 3. Projects Collection
    match /projects/{projectId} {
      // Allow read if admin, project owner, or if public/workshop study is published
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.ownerUid == request.auth.uid) ||
        resource.data.status == 'published' ||
        projectId == 'proj-taller-rsn';

      // Creation allowed for authenticated non-anonymous users with matching ownerUid, or admin
      allow create: if (isAuthenticated() && !isAnonymous() && request.resource.data.ownerUid == request.auth.uid) || isAdmin();

      // Updates and deletion restricted to owner or admin
      allow update, delete: if isAdmin() ||
        (isAuthenticated() && resource.data.ownerUid == request.auth.uid);

      // Stimuli Subcollection
      match /stimuli/{stimulusId} {
        allow read: if true;
        allow write: if isAdmin() ||
          (isAuthenticated() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid);
      }

      // Normalization Rules Subcollection
      match /normalization_rules/{ruleId} {
        allow read, write: if isAdmin() ||
          (isAuthenticated() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid);
      }

      // Semantic Interpretations Subcollection
      match /interpretations/{docId} {
        allow read, write: if isAdmin() ||
          (isAuthenticated() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid);
      }

      // Sessions Subcollection
      match /sessions/{sessionId} {
        allow read: if isAdmin() ||
          (isAuthenticated() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid) ||
          (isAuthenticated() && resource.data.authUid == request.auth.uid);
        allow create: if isAuthenticated();
        allow update: if isAdmin() ||
          (isAuthenticated() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid) ||
          (isAuthenticated() && resource.data.authUid == request.auth.uid);
        allow delete: if isAdmin() ||
          (isAuthenticated() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid);
      }

      // Responses Subcollection (Maximum participant privacy)
      match /responses/{responseId} {
        allow create: if isAuthenticated();
        allow read: if isAdmin() ||
          (isAuthenticated() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid);
        allow update, delete: if isAdmin() ||
          (isAuthenticated() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid);
      }
    }

    // 4. Feedback and Support Tickets
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated() && !isAnonymous() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // 5. Audit Logs
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // 6. System Stats
    match /systemStats/{statId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
